{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "omega-design/icon",
	"title": "Omega Icon",
	"category": "omega-design",
	"icon": "art",
	"description": "Insert one of the theme's animated stroke icons. Add the \"omega-ico-host\" class to an ancestor block to trigger its hover animation.",
	"keywords": ["icon", "svg", "omega"],
	"textdomain": "omega-design",
	"attributes": {
		"icon": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false,
			"gradients": false,
			"link": false
		},
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "omega-icon-block-editor",
	"style": "omega-icon-block"
}
